# Copy to .env.langfuse and replace every value (e.g. `openssl rand -hex 32`). Never commit .env.langfuse.
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=64-hex-characters-from-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
# API keys the app uses to send traces (also put LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY in .env)
LANGFUSE_PUBLIC_KEY=pk-lf-local-change-me
LANGFUSE_SECRET_KEY=sk-lf-local-change-me
# Login for the web UI at http://localhost:3000
LANGFUSE_ADMIN_EMAIL=admin@mizan.local
LANGFUSE_ADMIN_PASSWORD=change-me
